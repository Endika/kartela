{
  "name": "kartela",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "description": "Pick your favourite movie poster, one duel at a time — offline PWA for kids",
  "license": "MIT",
  "author": "Endika Iglesias",
  "homepage": "https://endika.github.io/kartela/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Endika/kartela.git"
  },
  "bugs": "https://github.com/Endika/kartela/issues",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src tools tests --ext .ts --max-warnings 0 --no-error-on-unmatched-pattern",
    "format": "prettier --write \"{src,tests,tools}/**/*.{ts,json,css}\"",
    "format:check": "prettier --check \"{src,tests,tools}/**/*.{ts,json,css}\"",
    "type:check": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "fetch:catalog": "tsx tools/fetch-catalog.ts",
    "gen:icons": "tsx tools/gen-icons.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
